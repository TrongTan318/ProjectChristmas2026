# ===== Bắt buộc =====
# Chuỗi kết nối PostgreSQL. Trong docker compose, host là "postgres".
DATABASE_URL=postgresql://hangda:CHANGE_ME_DB_PASSWORD@postgres:5432/hangda?schema=public
POSTGRES_USER=hangda
POSTGRES_PASSWORD=CHANGE_ME_DB_PASSWORD
POSTGRES_DB=hangda

# Địa chỉ public của website (in trong QR phiếu, Open Graph, sitemap).
PUBLIC_BASE_URL=https://hangda.example.com

# Bí mật ký phiên admin và phiên bình chọn. Sinh bằng: openssl rand -base64 48
SESSION_SECRET=CHANGE_ME_AT_LEAST_32_CHARS_LONG_SECRET

# Bí mật HMAC cho token phiếu. KHÔNG ĐỔI sau khi đã in phiếu (phiếu cũ sẽ mất hiệu lực).
TOKEN_SECRET=CHANGE_ME_AT_LEAST_32_CHARS_LONG_SECRET

# Salt băm địa chỉ IP (chống gian lận mà không lưu IP thô).
IP_SALT=CHANGE_ME_AT_LEAST_16_CHARS

# ===== Tùy chọn =====
# Thư mục lưu ảnh/video đã xử lý.
UPLOAD_DIR=/app/storage/media
# "true" khi chạy sau HTTPS (bật cờ Secure cho cookie).
COOKIE_SECURE=true

# Tài khoản Super Admin tạo khi chạy seed lần đầu.
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=CHANGE_ME_STRONG_PASSWORD
# "true" để tạo dữ liệu mẫu (13 đội, sản phẩm, ảnh minh họa).
SEED_DEMO=false

# Sao lưu: số giây giữa 2 lần backup (nên đặt 900 trong thời gian bình chọn).
BACKUP_INTERVAL_SECONDS=3600
BACKUP_KEEP=48
